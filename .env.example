################################################################################
#                                 WebApp .env                                  #
################################################################################

# Pour la doc des variables, voir config.ts

##
# Misc
## 

NEXTAUTH_URL=http://localhost:3000 # ou http://pilote.localhost avec Traefik
LOG_LEVEL=info

NEXT_PUBLIC_MATOMO_URL=TBD # Matomo Analytics
NEXT_PUBLIC_MATOMO_SITE_ID=TBD

CENTREAIDE_GITHUB_TOKEN=token # Centre d'aide

##
# Database
## 

DATABASE_URL="postgresql://postgresql:secret@localhost:5432/postgresql"
CONN_STR_PROD=TBD # descente de prod
CONN_STR_DEST=TBD # descente de prod

##
# Auth & Keycloak
## 

NEXTAUTH_SECRET=TBD # Peut être généré par la commande `openssl rand -base64 32`

DEV_PASSWORD="mot de passe"

TOKEN_API_SECRET=TBD
TOKEN_API_E2E_JOHAN=TBD
TOKEN_API_E2E_EQUIPE_DIR_PROJET=TBD

KEYCLOAK_CLIENT_ID=TBD
KEYCLOAK_CLIENT_SECRET=TDB
KEYCLOAK_ISSUER=TDB

IMPORT_KEYCLOAK_URL=TBD
IMPORT_CLIENT_ID=TBD
IMPORT_CLIENT_SECRET=TBD

# e.g. johan.boucaut@modernisation.gouv.fr
API_DITP_USERNAME="TBD"
# e.g. alexandre.leger@service-civique.gouv.fr - Utilisateur de test pour l'équipe de direction des projets ayant accès à un chantier CH-157 et à l'indicateur IND-439
API_DIR_PROJET_USERNAME="TBD"
# Favoriser l'engagement civique des jeunes
API_DIR_PROJET_CHANTIER_ASSOCIE="CH-157"
# Nombre de volontaires en Service Civique
API_DIR_PROJET_INDICATEUR_ASSOCIE="IND-439"
# Email de connexion permettant de créer des tokens API
E2E_USERNAME=TBD
# Mot de passe de connexion permettant de créer des tokens API
E2E_PASSWORD=TBD

##
# Feature flipping
## 

# Voir les NEXT_PUBLIC_FF_* dans le config.ts
