{
  "name": "pilote-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "dev:ppg": "pnpm -F @pilote/ppg dev",
    "dev:kpilote-api": "pnpm -F @pilote/kpilote-api dev",
    "dev:kpilote-webapp": "pnpm -F @pilote/kpilote-webapp dev",
    "build": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} deploy:prepare && pnpm -F ${APP_PACKAGE:-@pilote/ppg} build && pnpm -F ${APP_PACKAGE:-@pilote/ppg} deploy:bundle",
    "build:dev": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} build:dev",
    "start": "bash start.sh",
    "lint": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} lint",
    "lint:fix": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} lint:fix",
    "format": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} format",
    "format:check": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} format:check",
    "test": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} test",
    "test:client": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} test:client",
    "test:server": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} test:server",
    "test:e2e": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} test:e2e",
    "test:e2e:seed": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} test:e2e:seed",
    "test:e2e:ui": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} test:e2e:ui",
    "test:database:init": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} test:database:init",
    "database:init": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} database:init",
    "database:init-force": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} database:init-force",
    "database:migration": "pnpm -F ${APP_PACKAGE:-@pilote/ppg} database:migration",
    "deps:campagne": "node scripts/deps-campagne/run.mjs",
    "deps:campagne:test": "node --test \"scripts/deps-campagne/lib/**/*.test.mjs\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "@tree-sitter-grammars/tree-sitter-yaml",
      "esbuild",
      "prisma",
      "sharp",
      "tree-sitter",
      "tree-sitter-json",
      "unrs-resolver"
    ],
    "overrides": {
      "@hono/node-server": ">=1.19.15 <2",
      "@xmldom/xmldom": ">=0.9.10 <0.10",
      "mermaid": ">=11.16.1 <12",
      "hono": ">=4.12.34 <5",
      "postcss": ">=8.5.23 <9",
      "sharp": ">=0.35.0 <0.36",
      "brace-expansion@<2": ">=1.1.18 <2",
      "brace-expansion@>=2 <3": ">=2.1.2 <3",
      "brace-expansion@>=5 <6": ">=5.0.9 <6",
      "undici@>=7 <8": ">=7.29.0 <8",
      "linkify-it@>=5 <6": ">=5.0.2 <6",
      "immutable@>=4 <5": ">=4.3.9 <5",
      "js-yaml@<4": ">=3.15.1 <4",
      "js-yaml@>=4 <5": ">=4.3.1 <5",
      "tar@>=7 <8": ">=7.5.21 <8",
      "fast-uri@>=3 <4": ">=3.1.4 <4",
      "eslint-plugin-sonarjs>typescript": "5.9.3",
      "deepmerge-ts": ">=8.0.0 <9"
    }
  },
  "devDependencies": {
    "semver": "^7.8.5"
  }
}
