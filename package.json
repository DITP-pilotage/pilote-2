{
  "name": "ditp-pilote",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "18 || 20 || 24.9.0"
  },
  "scripts": {
    "dev": "next dev | pino-pretty",
    "build": "bash scripts/clone_centre_aide.sh && next build && npx pagefind --site .next/server/app --output-path public/_pagefind && node copy-assets.js && prisma migrate deploy && prisma db seed",
    "build:dev": "next build && npx pagefind --site .next/server/app --output-path public/_pagefind && node copy-assets.js && prisma migrate deploy && prisma db seed",
    "start": "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-384} .next/standalone/server.js",
    "lint": "prisma generate && npm run lint:eslint && npm run lint:tsc && npm run lint:stylelint",
    "lint:fix": "npm run lint:eslint -- --fix && npm run lint:stylelint -- --fix",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "lint:eslint": "eslint '{src,tests}/**/*.{ts,tsx}' --quiet",
    "lint:tsc": "npx tsc",
    "lint:stylelint": "npx stylelint 'src/**/*.styled.{ts,tsx}'",
    "test": "vitest run",
    "test:client": "vitest run --project client",
    "test:client:unit": "vitest run --project client '.unit.test.'",
    "test:client:integration": "vitest run --project client '.integration.test.'",
    "test:client:coverage": "vitest run --project client --coverage",
    "test:server": "vitest run --project server-unit --project server-integration",
    "test:e2e": "npx playwright test --workers=1",
    "test:e2e:seed": "./tests/seed/seed.sh",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:server": "dotenv -e .env.e2e npm run dev",
    "test:e2e:database:init": "dotenv -e .env.e2e -- npm run database:init -- --force",
    "test:server:unit": "vitest run --project server-unit",
    "test:server:integration": "vitest run --project server-integration",
    "test:server:domain:coverage": "vitest run --project server-unit --coverage 'src/server/domain/**/*.test.*'",
    "test:server:infrastructure:coverage": "vitest run --project server-unit --coverage 'src/server/infrastructure/**/*.test.*'",
    "test:database:init": "dotenv -e .env.test -- npm run database:init -- --force",
    "database:init": "prisma migrate reset",
    "database:init-force": "prisma migrate reset --force",
    "database:migration": "prisma migrate dev",
    "centreaide:init": "git submodule update --init --recursive",
    "centreaide:clean": "git submodule deinit -f src/content"
  },
  "overrides": {
    "lodash-es": "4.17.23",
    "@asamuzakjp/css-color": {
      "@csstools/css-tokenizer": "^4.0.0"
    }
  },
  "prisma": {
    "schema": "src/database/prisma/schema.prisma",
    "seed": "ts-node src/database/prisma/seed.ts"
  },
  "browserslist": {
    "production": [
      ">0.2% in FR",
      "last 5 years",
      "not IE <= 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
