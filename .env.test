# Environment
NODE_ENV=test

# Application
BASE_URL=http://localhost:3000
LOG_LEVEL=silent

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# Development authentication (use empty for tests with mocked auth)
DEV_PASSWORD=test-password

# NextAuth
NEXTAUTH_SECRET=test-secret-key-for-nextauth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_DEBUG=false
NEXTAUTH_SESSION_MAX_AGE_IN_SECONDS=2592000

# Keycloak (disabled in tests)
KEYCLOAK_CLIENT_ID=to-be-defined
KEYCLOAK_CLIENT_SECRET=to-be-defined
KEYCLOAK_ISSUER=to-be-defined

# Import settings
IMPORT_KEYCLOAK_URL=to-be-defined
IMPORT_CLIENT_ID=to-be-defined
IMPORT_CLIENT_SECRET=to-be-defined
URL_VALIDATA=https://api.validata.etalab.studio/validate

# Export settings
EXPORT_CSV_CHANTIERS_CHUNK_SIZE=5
EXPORT_CSV_INDICATEURS_CHUNK_SIZE=5

# Webapp
WEBAPP_BASE_URL=http://localhost:3000

# Descente de prod (disabled in tests)
CONN_STR_PROD=postgres://usr:pwd@host:port/db_name
CONN_STR_DEST=postgres://usr:pwd@host:port/db_name

# Centre d'aide
CENTREAIDE_GITHUB_FOLDER=integration-pilote
CENTREAIDE_GITHUB_TOKEN=to-be-defined
CENTREAIDE_ASSETS_FOLDER=to-be-defined

# Feature Flags
NEXT_PUBLIC_FF_NOUVELLE_PAGE_ACCUEIL=false
NEXT_PUBLIC_FF_RAPPORT_DETAILLE=true
NEXT_PUBLIC_FF_INFOBULLE_PONDERATION=false
NEXT_PUBLIC_FF_DATE_METEO=false
NEXT_PUBLIC_LIMITE_CARACTERES_PUBLICATION=6000
NEXT_PUBLIC_FF_ALERTES=true
NEXT_PUBLIC_FF_ALERTES_BAISSE=false
NEXT_PUBLIC_FF_APPLICATION_INDISPONIBLE=false
NEXT_PUBLIC_FF_FICHE_CONDUCTEUR=false
NEXT_PUBLIC_FF_FICHE_TERRITORIALE=true
NEXT_PUBLIC_FF_TA_ANNUEL=false
NEXT_PUBLIC_FF_GESTION_TOKEN_API=false
NEXT_PUBLIC_FF_SUIVI_COMPLETUDE=false
NEXT_PUBLIC_FF_ALERTE_MAJ_INDICATEUR=false
NEXT_PUBLIC_FF_PROPOSITION_VOIR_HISTORIQUE=false
NEXT_PUBLIC_FF_DOCS_API=false
NEXT_PUBLIC_FF_PPG_ARCHIVE=false
NEXT_PUBLIC_FF_POSER_UNE_QUESTION_INDICATEUR=false
NEXT_PUBLIC_FF_VIDEO_ACCUEIL=false
NEXT_PUBLIC_FF_PVA_VALEUR_DIFFERENTE=false
NEXT_PUBLIC_FF_PILOTE_EVAL=false

# Analytics (disabled in tests)
NEXT_PUBLIC_MATOMO_URL=https://stats.beta.gouv.fr
NEXT_PUBLIC_MATOMO_SITE_ID=103
NEXT_PUBLIC_RECORD_ANALYTICS=false

# API Token
TOKEN_API_SECRET=test-secret
TOKEN_API_E2E_JOHAN=test-token-johan
TOKEN_API_E2E_EQUIPE_DIR_PROJET=test-token-equipe-dir-projet
CHANTIER_ID_ACCESSIBLE_PAR_UTILISATEUR_EQUIPE_DIR_PROJET=test-chantier-id
INDICATEUR_ID_ACCESSIBLE_PAR_UTILISATEUR_EQUIPE_DIR_PROJET=test-indicateur-id

# Dates
NEXT_PUBLIC_DATE_BASCULE_AFFICHAGE_VALEURS_ANNEE_PRECEDENTE=2000-01-31

# Schema Validata
NEXT_PUBLIC_SCHEMA_VALIDATA_URL=https://raw.githubusercontent.com/DITP-pilotage/pilote-2/dev/public/schema/

# E2E Testing
E2E_USERNAME=test-user
API_DITP_USERNAME=test-ditp-admin
API_DIR_PROJET_USERNAME=test-dir-projet
API_DIR_PROJET_CHANTIER_ASSOCIE=test-chantier
API_DIR_PROJET_INDICATEUR_ASSOCIE=test-indicateur

# Brevo (emails disabled in tests)
BREVO_API_KEY=to-be-defined
DISABLE_EMAILS=true

# CRON
CRON_AUTH_SECRET=test-cron-secret
