# Environment
NODE_ENV=development
PORT=3030

# Application
BASE_URL=http://localhost:3030
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:7474/postgres?sslmode=prefer

# Development authentication (replaces OIDC for e2e tests)
DEV_PASSWORD=password

# NextAuth
NEXTAUTH_SECRET=S5WfQZlozTMzcxm1A7Fo37q4LlcEAJf50xiYl+R4SJ0=
NEXTAUTH_URL=http://localhost:3030
NEXTAUTH_DEBUG=false
NEXTAUTH_SESSION_MAX_AGE_IN_SECONDS=2592000

# Keycloak (disabled in e2e)
KEYCLOAK_CLIENT_ID=to-be-defined
KEYCLOAK_CLIENT_SECRET=to-be-defined
KEYCLOAK_ISSUER=to-be-defined

# Import settings (disabled in e2e)
IMPORT_KEYCLOAK_URL=to-be-defined
IMPORT_CLIENT_ID=to-be-defined
IMPORT_CLIENT_SECRET=to-be-defined
URL_VALIDATA=https://api.validata.etalab.studio/validate

# Export settings
EXPORT_CSV_CHANTIERS_CHUNK_SIZE=5
EXPORT_CSV_INDICATEURS_CHUNK_SIZE=5

# Webapp
WEBAPP_BASE_URL=http://localhost:3030

# Descente de prod (disabled in e2e)
CONN_STR_PROD=postgres://usr:pwd@host:port/db_name
CONN_STR_DEST=postgres://usr:pwd@host:port/db_name

# Centre d'aide (disabled in e2e)
CENTREAIDE_GITHUB_FOLDER=integration-pilote
CENTREAIDE_GITHUB_TOKEN=to-be-defined
CENTREAIDE_ASSETS_FOLDER=to-be-defined

# Feature Flags (most enabled for comprehensive e2e testing)
NEXT_PUBLIC_FF_NOUVELLE_PAGE_ACCUEIL=true
NEXT_PUBLIC_FF_RAPPORT_DETAILLE=true
NEXT_PUBLIC_FF_INFOBULLE_PONDERATION=true
NEXT_PUBLIC_FF_DATE_METEO=true
NEXT_PUBLIC_LIMITE_CARACTERES_PUBLICATION=6000
NEXT_PUBLIC_FF_ALERTES=true
NEXT_PUBLIC_FF_ALERTES_BAISSE=true
NEXT_PUBLIC_FF_APPLICATION_INDISPONIBLE=false
NEXT_PUBLIC_FF_FICHE_CONDUCTEUR=true
NEXT_PUBLIC_FF_FICHE_TERRITORIALE=true
NEXT_PUBLIC_FF_TA_ANNUEL=true
NEXT_PUBLIC_FF_GESTION_TOKEN_API=true
NEXT_PUBLIC_FF_SUIVI_COMPLETUDE=true
NEXT_PUBLIC_FF_ALERTE_MAJ_INDICATEUR=true
NEXT_PUBLIC_FF_PROPOSITION_VOIR_HISTORIQUE=false
NEXT_PUBLIC_FF_DOCS_API=true
NEXT_PUBLIC_FF_PPG_ARCHIVE=true
NEXT_PUBLIC_FF_POSER_UNE_QUESTION_INDICATEUR=true
NEXT_PUBLIC_FF_VIDEO_ACCUEIL=true
NEXT_PUBLIC_FF_PVA_VALEUR_DIFFERENTE=false
NEXT_PUBLIC_FF_PILOTE_EVAL=false

# Analytics (disabled in e2e)
NEXT_PUBLIC_MATOMO_URL=https://stats.beta.gouv.fr
NEXT_PUBLIC_MATOMO_SITE_ID=103
NEXT_PUBLIC_RECORD_ANALYTICS=false

# API Token
TOKEN_API_SECRET=e2e-secret
TOKEN_API_E2E_JOHAN=e2e-token-johan
TOKEN_API_E2E_EQUIPE_DIR_PROJET=e2e-token-equipe-dir-projet
CHANTIER_ID_ACCESSIBLE_PAR_UTILISATEUR_EQUIPE_DIR_PROJET=e2e-chantier-id
INDICATEUR_ID_ACCESSIBLE_PAR_UTILISATEUR_EQUIPE_DIR_PROJET=e2e-indicateur-id

# Dates
NEXT_PUBLIC_DATE_BASCULE_AFFICHAGE_VALEURS_ANNEE_PRECEDENTE=2000-03-31

# Schema Validata
NEXT_PUBLIC_SCHEMA_VALIDATA_URL=https://raw.githubusercontent.com/DITP-pilotage/pilote-2/dev/public/schema/

# E2E Testing
E2E_USERNAME=ditp.admin@example.com
API_DITP_USERNAME=e2e-ditp-admin
API_DIR_PROJET_USERNAME=e2e-dir-projet
API_DIR_PROJET_CHANTIER_ASSOCIE=e2e-chantier
API_DIR_PROJET_INDICATEUR_ASSOCIE=e2e-indicateur

# Brevo (emails disabled in e2e)
BREVO_API_KEY=to-be-defined
DISABLE_EMAILS=true

# CRON
CRON_AUTH_SECRET=e2e-cron-secret
