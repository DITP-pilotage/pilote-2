// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "raw_data"]
}

enum Maille {
  NAT  @map("nat")
  DEPT @map("dept")
  REG  @map("reg")

  @@map("maille")
  @@schema("public")
}

model territoire {
  code                  String                  @id
  nom                   String
  nom_affiche           String
  maille                Maille
  code_insee            String
  code_parent           String?
  indicateur_territoire indicateur_territoire[]
  chantier_territoire   chantier_territoire[]
  zone_id               String
  territoire_parent     territoire?             @relation("territoire_parent", fields: [code_parent], references: [code], onDelete: Cascade, onUpdate: Cascade)
  territoire_enfant     territoire[]            @relation("territoire_parent")

  @@schema("public")
}

enum type_ate {
  ate
  hors_ate_deconcentre
  hors_ate_centralise

  @@schema("public")
}

enum type_statut {
  BROUILLON
  PUBLIE
  ARCHIVE
  SUPPRIME

  @@schema("public")
}

enum type_statut_indicateur {
  PUBLIE
  SUPPRIME

  @@schema("public")
}

enum type_tendance {
  HAUSSE
  BAISSE
  STAGNATION

  @@schema("public")
}

enum type_statut_proposition {
  EN_COURS
  RETIREE
  ANNULEE
  ACCEPTEE_VIA_IMPORT
  TRAITEE_VIA_IMPORT
  IGNOREE_VIA_IMPORT

  @@schema("public")
}

model chantier_identite {
  id                                    String                 @id
  nom                                   String
  perimetre_ids                         String[]
  directeurs_administration_centrale    String[]
  directions_administration_centrale    String[]
  ministeres                            String[]
  ministeres_acronymes                  String[]
  directeurs_projet                     String[]
  axe                                   String                 @default("non renseigné")
  ppg                                   String                 @default("non renseignée")
  directeurs_projet_mails               String[]
  est_barometre                         Boolean?
  est_territorialise                    Boolean?
  ate                                   type_ate?
  possede_taux_avancement_departemental Boolean?
  possede_taux_avancement_regional      Boolean?
  possede_meteo_departemental           Boolean?
  possede_meteo_regional                Boolean?
  statut                                type_statut            @default(PUBLIE)
  cible_attendue                        Boolean                @default(true)
  conseiller_mail                       String?
  a_supprimer                           Boolean                @default(true)
  mailles_applicables                   Maille[]
  chantier_territoire                   chantier_territoire[]
  indicateur_identite                   indicateur_identite[]
  objectifs                             objectif[]
  decisions_strategiques                decision_strategique[]

  @@schema("public")
}

model chantier_territoire {
  id                                            String
  territoire_code                               String
  territoire                                    territoire                  @relation(fields: [territoire_code], references: [code], onDelete: Cascade, onUpdate: Cascade)
  code_insee                                    String
  maille                                        Maille
  zone_id                                       String
  taux_avancement_mandat                        Float?
  date_taux_avancement_mandat                   DateTime?                   @db.Date
  territoire_nom                                String?
  meteo                                         String?                     @default("NON_RENSEIGNEE")
  taux_avancement_mandat_valeur_precedente      Float?
  date_taux_avancement_mandat_valeur_precedente DateTime?                   @db.Date
  est_applicable                                Boolean?
  responsables_locaux                           String[]
  coordinateurs_territoriaux                    String[]
  responsables_locaux_mails                     String[]
  coordinateurs_territoriaux_mails              String[]
  derniere_maj_date_qualitative                 DateTime?                   @db.Date
  tendance                                      type_tendance?
  tendance_int_index                            Float?
  ecart                                         Float?
  meteo_int_index                               Float?
  donnees_maille_source                         Maille?
  nombre_propositions_valeur_actuelle           Int                         @default(0)
  nombre_propositions_valeur_actuelle_ponderee  Int                         @default(0)
  chantier_identite                             chantier_identite           @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chantier_territoire_jalon                     chantier_territoire_jalon[]
  commentaires                                  commentaire[]
  syntheses_des_resultats                       synthese_des_resultats[]
  indicateur_territoire                         indicateur_territoire[]

  @@id([id, territoire_code])
  @@schema("public")
}

model chantier_territoire_jalon {
  id                   String
  code_insee           String
  maille               Maille
  territoire_code      String
  zone_id              String
  jalon                Int
  taux_avancement      Float?
  taux_avancement_eval Float?
  date_taux_avancement DateTime? @db.Date

  chantier_territoire chantier_territoire @relation(fields: [id, territoire_code], references: [id, territoire_code], onDelete: Cascade, onUpdate: Cascade)

  @@id([id, territoire_code, jalon])
  @@schema("public")
}

model ministere {
  id          String      @id
  acronyme    String
  nom         String
  perimetre   perimetre[]
  icone       String?
  a_supprimer Boolean     @default(true)

  @@schema("public")
}

model perimetre {
  id              String     @id
  nom             String
  ministere       String?
  ministere_table ministere? @relation(fields: [ministere_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ministere_id    String?
  a_supprimer     Boolean    @default(true)

  @@schema("public")
}

model indicateur_identite {
  id                         String                  @id
  nom                        String
  chantier_id                String
  type_id                    String?
  type_nom                   String?
  est_barometre              Boolean?
  est_phare                  Boolean?
  description                String?
  source                     String?
  mode_de_calcul             String?
  unite_mesure               String?
  a_supprimer                Boolean                 @default(true)
  dernier_import_date_indic  DateTime?               @db.Date
  periodicite                String?
  delai_disponibilite        Int?
  parent_id                  String?
  responsables_donnees_mails String[]
  maille_nat_agregee         Boolean                 @default(false)
  maille_reg_agregee         Boolean                 @default(false)
  statut                     type_statut_indicateur  @default(PUBLIE)
  indicateur_territoire      indicateur_territoire[]
  mailles_applicables        Maille[]
  chantier_identite          chantier_identite       @relation(fields: [chantier_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([chantier_id])
  @@schema("public")
}

model indicateur_territoire {
  id                                     String
  chantier_id                            String
  maille                                 Maille
  territoire_code                        String
  code_insee                             String
  zone_id                                String
  valeur_cible_mandat                    Float?
  taux_avancement_mandat                 Float?
  date_valeur_actuelle_mandat            DateTime?                                @db.Date
  date_valeur_initiale                   DateTime?                                @db.Date
  valeur_actuelle_mandat                 Float?
  valeur_initiale                        Float?
  territoire_nom                         String?
  date_valeur_cible_mandat               DateTime?                                @db.Date
  est_applicable                         Boolean?
  ponderation_zone_declaree              Float?
  ponderation_zone_reel                  Float?
  ponderation_zone_declaree_eval         Float?
  ponderation_zone_reel_eval             Float?
  est_a_jour                             Boolean?
  prochaine_date_maj                     DateTime?                                @db.Date
  prochaine_date_maj_jours               Int?
  tendance                               String?
  taux_avancement_mandat_proposition     Float?
  prochaine_date_valeur_actuelle         DateTime?                                @db.Date
  evolution_valeur_actuelle              Json?
  territoire                             territoire                               @relation(fields: [territoire_code], references: [code], onDelete: Cascade, onUpdate: Cascade)
  indicateur_identite                    indicateur_identite                      @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  chantier_territoire                    chantier_territoire                      @relation(fields: [chantier_id, territoire_code], references: [id, territoire_code], onDelete: Cascade, onUpdate: Cascade)
  indicateur_territoire_jalon            indicateur_territoire_jalon[]
  proposition_valeur_actuelle            proposition_valeur_actuelle[]
  indicateur_territoire_valeur_evenement indicateur_territoire_valeur_evenement[]

  @@id([id, territoire_code])
  @@index([territoire_code])
  @@index([chantier_id])
  @@index([id, territoire_code, chantier_id])
  @@schema("public")
}

model indicateur_territoire_jalon {
  id                          String
  territoire_code             String
  code_insee                  String
  maille                      Maille
  jalon                       Int
  zone_id                     String
  date_valeur_cible           DateTime?             @db.Date
  taux_avancement             Float?
  valeur_cible                Float?
  taux_avancement_proposition Float?
  date_valeur_actuelle        DateTime?             @db.Date
  valeur_actuelle             Float?
  indicateur_territoire       indicateur_territoire @relation(fields: [id, territoire_code], references: [id, territoire_code], onDelete: Cascade, onUpdate: Cascade)

  @@id([id, territoire_code, jalon])
  @@index([id, territoire_code])
  @@index([jalon])
  @@schema("public")
}

model synthese_des_resultats {
  id                  String              @id
  chantier_id         String
  maille              String
  code_insee          String
  territoire_code     String
  meteo               String?
  date_meteo          DateTime?           @db.Timestamp
  commentaire         String?
  date_commentaire    DateTime?           @db.Timestamp
  auteur_synthese     utilisateur?        @relation(fields: [auteur_id], references: [id], onUpdate: Cascade)
  auteur_id           String?             @db.Uuid
  chantier_territoire chantier_territoire @relation(fields: [chantier_id, territoire_code], references: [id, territoire_code], onUpdate: Cascade)

  @@schema("public")
}

model axe {
  id          String  @id
  nom         String
  a_supprimer Boolean @default(true)

  @@schema("public")
}

model ppg {
  id          String  @id
  nom         String
  a_supprimer Boolean @default(true)

  @@schema("public")
}

model commentaire {
  id                  String              @id
  chantier_id         String
  type                String
  contenu             String
  date                DateTime            @db.Timestamp
  maille              String
  code_insee          String
  territoire_code     String
  auteur_commentaire  utilisateur?        @relation(fields: [auteur_id], references: [id], onUpdate: Cascade)
  chantier_territoire chantier_territoire @relation(fields: [chantier_id, territoire_code], references: [id, territoire_code], onUpdate: Cascade)
  auteur_id           String?             @db.Uuid

  @@schema("public")
}

model mesure_indicateur {
  id           String                            @id @db.Uuid
  indic_id     String
  zone_id      String
  metric_date  String
  metric_type  String
  metric_value String
  rapport_id   String?                           @db.Uuid
  rapport      rapport_import_mesure_indicateur? @relation(fields: [rapport_id], references: [id])
  date_import  DateTime?                         @default(now()) @db.Timestamptz

  @@schema("raw_data")
}

model metadata_indicateurs {
  indic_id             String   @id
  indic_parent_indic   String?
  indic_parent_ch      String
  indic_nom            String
  indic_nom_baro       String?
  indic_descr          String?
  indic_descr_baro     String?
  indic_is_perseverant Boolean?
  indic_is_phare       Boolean?
  indic_is_baro        Boolean?
  indic_type           String?
  indic_source         String?
  indic_source_url     String?
  indic_methode_calcul String?
  indic_unite          String?
  indic_hidden_pilote  Boolean?
  indic_schema         String?
  zg_applicable        String?

  @@schema("raw_data")
}

model metadata_indicateurs_hidden {
  indic_id             String   @id
  indic_parent_indic   String?
  indic_parent_ch      String
  indic_nom            String
  indic_nom_baro       String?
  indic_descr          String?
  indic_descr_baro     String?
  indic_is_perseverant Boolean?
  indic_is_phare       Boolean?
  indic_is_baro        Boolean?
  indic_type           String?
  indic_source         String?
  indic_source_url     String?
  indic_methode_calcul String?
  indic_unite          String?
  indic_hidden_pilote  Boolean?
  indic_schema         String?
  zg_applicable        String?

  @@schema("raw_data")
}

model metadata_parametrage_indicateurs {
  indic_id                          String  @id
  vi_dept_from                      String?
  vi_dept_op                        String?
  va_dept_from                      String?
  va_dept_op                        String?
  vc_dept_from                      String?
  vc_dept_op                        String?
  vi_reg_from                       String?
  vi_reg_op                         String?
  va_reg_from                       String?
  va_reg_op                         String?
  vc_reg_from                       String?
  vc_reg_op                         String?
  vi_nat_from                       String?
  vi_nat_op                         String?
  va_nat_from                       String?
  va_nat_op                         String?
  vc_nat_from                       String?
  vc_nat_op                         String?
  param_vaca_decumul_from           String?
  param_vaca_partition_date         String?
  param_vaca_op                     String?
  param_vacg_decumul_from           String?
  param_vacg_partition_date         String?
  param_vacg_op                     String?
  poids_pourcent_dept_declaree      Float?
  poids_pourcent_reg_declaree       Float?
  poids_pourcent_nat_declaree       Float?
  poids_pourcent_eval_dept_declaree Float?
  poids_pourcent_eval_reg_declaree  Float?
  poids_pourcent_eval_nat_declaree  Float?
  tendance                          String?

  @@schema("raw_data")
}

model metadata_indicateurs_complementaire {
  indic_id                  String   @id
  reforme_prioritaire       String?
  projet_annuel_perf        Boolean?
  detail_projet_annuel_perf String?
  periodicite               String?
  delai_disponibilite       Int?
  indic_territorialise      Boolean?
  frequence_territoriale    String?
  mailles                   String?
  admin_source              String?
  methode_collecte          String?
  si_source                 String?
  donnee_ouverte            Boolean?
  modalites_donnee_ouverte  String?
  resp_donnees              String?
  resp_donnees_email        String?
  contact_technique         String?
  contact_technique_email   String?
  commentaire               String?
  maille_pilotage           String
  cible_attendue            Boolean  @default(true)
  couverture_temporelle     String

  @@schema("raw_data")
}

model commentaires {
  chantier_id  String
  maille       String
  code_insee   String
  date         String
  type         String
  contenu      String?
  meteo        String?
  date_meteo   String?
  auteur_email String?

  @@id([chantier_id, code_insee, maille, type, date])
  @@schema("raw_data")
}

model mesure_indicateur_temporaire {
  id           String                           @id @db.Uuid
  indic_id     String?
  zone_id      String?
  metric_date  String?
  metric_type  String?
  metric_value String?
  rapport_id   String                           @db.Uuid
  rapport      rapport_import_mesure_indicateur @relation(fields: [rapport_id], references: [id])
  date_import  DateTime?                        @default(now()) @db.Timestamptz

  @@schema("public")
}

model erreur_validation_fichier {
  id                String                           @id @db.Uuid
  nom               String
  cellule           String
  message           String
  nom_du_champ      String
  numero_de_ligne   Int
  position_de_ligne Int
  position_du_champ Int
  rapport_id        String                           @db.Uuid
  rapport           rapport_import_mesure_indicateur @relation(fields: [rapport_id], references: [id])

  @@schema("public")
}

model rapport_import_mesure_indicateur {
  id                           String                         @id @db.Uuid
  date_creation                DateTime                       @db.Timestamptz
  utilisateurEmail             String                         @map("utilisateur_email")
  est_valide                   Boolean                        @default(false)
  utilisateur                  utilisateur                    @relation(fields: [utilisateurEmail], references: [email])
  mesure_indicateur_temporaire mesure_indicateur_temporaire[]
  erreur_validation_fichier    erreur_validation_fichier[]
  mesure_indicateur            mesure_indicateur[]

  @@schema("public")
}

enum type_objectif {
  notre_ambition
  deja_fait
  a_faire

  @@schema("public")
}

model objectif {
  id                String            @id
  type              type_objectif
  contenu           String
  date              DateTime          @db.Timestamp
  chantier_id       String
  auteur_objectif   utilisateur?      @relation(fields: [auteur_id], references: [id], onUpdate: Cascade)
  auteur_id         String?           @db.Uuid
  chantier_identite chantier_identite @relation(fields: [chantier_id], references: [id], onUpdate: Cascade)

  @@schema("public")
}

enum type_decision_strategique {
  suivi_des_decisions

  @@schema("public")
}

model decision_strategique {
  id                          String                    @id
  type                        type_decision_strategique
  contenu                     String
  date                        DateTime                  @db.Timestamp
  chantier_id                 String
  auteur_decision_strategique utilisateur?              @relation(fields: [auteur_id], references: [id], onUpdate: Cascade)
  auteur_id                   String?                   @db.Uuid
  chantier_identite           chantier_identite         @relation(fields: [chantier_id], references: [id], onUpdate: Cascade)

  @@schema("public")
}

model utilisateur {
  id                                     String                                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                  String                                   @unique
  nom                                    String
  prenom                                 String
  fonction                               String?
  profil                                 profil                                   @relation(fields: [profilCode], references: [code], onUpdate: Cascade)
  profilCode                             String                                   @map("profil_code")
  habilitation                           habilitation[]
  rapport_import_mesure_indicateur       rapport_import_mesure_indicateur[]
  date_modification                      DateTime                                 @default(now())
  auteur_modification                    utilisateur?                             @relation("modification", fields: [auteur_id_modification], references: [id])
  auteur_id_modification                 String?                                  @db.Uuid
  date_creation                          DateTime
  auteur_creation                        utilisateur?                             @relation("creation", fields: [auteur_id_creation], references: [id])
  auteur_id_creation                     String?                                  @db.Uuid
  commentaires                           commentaire[]
  decisions_strategique                  decision_strategique[]
  objectifs                              objectif[]
  syntheses                              synthese_des_resultats[]
  utilisateurs_crees                     utilisateur[]                            @relation("creation")
  utilisateur_modifies                   utilisateur[]                            @relation("modification")
  propositions_valeur_actuelle           proposition_valeur_actuelle[]
  date_desactivation                     DateTime?
  date_visualisation_video_accueil       DateTime?
  date_visualisation_popup_infolettre    DateTime?
  date_inscription_infolettre            DateTime?
  historisations_modification            historisation_modification[]
  indicateur_territoire_valeur_evenement indicateur_territoire_valeur_evenement[]
  applications_accessibles               application_accessible[]
  rattachement_utilisateur_etape_jalons  rattachement_utilisateur_etape_jalon[]
  evaluation_objectif                    evaluation_objectif[]
  evaluation_critere                     evaluation_critere[]

  @@schema("public")
}

model profil {
  code                                            String        @id
  nom                                             String
  a_acces_tous_chantiers                          Boolean       @default(false)
  a_acces_tous_chantiers_territorialises          Boolean       @default(false)
  a_acces_tous_les_territoires_lecture            Boolean       @default(false)
  a_acces_tous_les_chantiers_saisie_commentaire   Boolean       @default(false)
  a_acces_tous_les_territoires_saisie_commentaire Boolean       @default(false)
  a_acces_tous_les_territoires_saisie_indicateur  Boolean       @default(false)
  peut_modifier_les_utilisateurs                  Boolean       @default(false)
  a_acces_a_tous_les_territoires_utilisateurs     Boolean       @default(false)
  a_acces_a_tous_les_chantiers_utilisateurs       Boolean       @default(false)
  peut_saisir_des_commentaires                    Boolean       @default(false)
  a_access_aux_chantiers_brouillons               Boolean       @default(false)
  utilisateur                                     utilisateur[]

  @@schema("public")
}

model habilitation {
  utilisateur   utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  scope         scope       @relation(fields: [scopeCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  scopeCode     String      @map("scope_code")
  territoires   String[]
  perimetres    String[]
  chantiers     String[]

  @@unique([utilisateurId, scopeCode])
  @@schema("public")
}

model scope {
  code         String         @id
  nom          String
  habilitation habilitation[]

  @@schema("public")
}

model historisation_modification {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_objet_modifie     String
  utilisateur_nom      String?
  type_de_modification String
  date_de_modification String
  table_modifie_id     String
  ancienne_valeur      Json?
  nouvelle_valeur      Json?
  id_auteur            String?      @db.Uuid
  auteur_modification  utilisateur? @relation(fields: [id_auteur], references: [id], onUpdate: Cascade)

  @@schema("public")
}

model proposition_valeur_actuelle {
  id                           String                  @id @db.Uuid
  indic_id                     String
  valeur_actuelle_proposee     Float
  territoire_code              String
  date_valeur_actuelle         DateTime?               @db.Timestamp()
  id_auteur_modification       String                  @db.Uuid
  date_proposition             DateTime?               @db.Timestamp()
  motif_proposition            String
  source_donnee_methode_calcul String
  statut                       type_statut_proposition
  indicateur_territoire        indicateur_territoire   @relation(fields: [indic_id, territoire_code], references: [id, territoire_code], onUpdate: Cascade)

  auteur_proposition       utilisateur? @relation(fields: [id_auteur_modification], references: [id], onUpdate: Cascade)
  date_modification_statut DateTime?    @db.Timestamp()

  @@schema("public")
}

model gestion_contenu {
  nom_variable_contenu    String @id
  valeur_variable_contenu String

  @@schema("public")
}

model token_api_information {
  email         String @id
  date_creation String

  @@schema("public")
}

model nouveaute {
  id            String   @id
  contenu       String
  date_creation DateTime @default(now())
  version       String
  date          String

  @@schema("public")
}

model indicateur_territoire_valeur_evenement {
  id                      String                @id @db.Uuid
  indic_id                String
  territoire_code         String
  type_evenement          type_evenement
  type_valeur             type_valeur
  date_valeur             DateTime              @db.Date
  valeur                  Float?
  donnees_complementaires Json
  date_creation           DateTime              @default(now())
  ordre                   Int
  date_modification       DateTime              @updatedAt
  id_auteur_modification  String                @db.Uuid
  correlation_id          String                @db.Uuid
  indicateur_territoire   indicateur_territoire @relation(fields: [indic_id, territoire_code], references: [id, territoire_code])
  auteur                  utilisateur           @relation(fields: [id_auteur_modification], references: [id])

  @@index([indic_id, territoire_code, type_valeur])
  @@index([date_creation, ordre])
  @@schema("public")
}

model datajobs_execution {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  derniere_date_execution DateTime

  @@schema("public")
}

enum type_evenement {
  VALEUR_CREEE
  VALEUR_MODIFIEE
  VALEUR_HISTORISEE
  PROPOSITION_VALEUR_CREEE
  PROPOSITION_VALEUR_MODIFIEE
  PROPOSITION_VALEUR_SUPPRIMEE
  PROPOSITION_VALEUR_REFUSEE
  PROPOSITION_VALEUR_ACCUSEE_RECEPTION
  PROPOSITION_VALEUR_ACCEPTEE
  PROPOSITION_VALEUR_IGNOREE_VALEUR_MODIFIEE
  PROPOSITION_VALEUR_IGNOREE_VALEUR_HISTORISEE
  PROPOSITION_VALEUR_ACCEPTEE_AVEC_MODIFICATION

  @@schema("public")
}

enum type_valeur {
  VALEUR_AVANCEMENT
  VALEUR_CIBLE
  VALEUR_INITIALE

  @@schema("public")
}

enum application_accessible {
  PILOTE
  PILOTE_EVAL
  PILOTE_EVAL_PILOTAGE

  @@schema("public")
}

model referentiel_tutelle {
  id         String                 @id @db.Uuid
  nom        String
  created_at DateTime               @default(now())
  updated_at DateTime               @updatedAt
  objectifs  referentiel_objectif[]

  @@schema("public")
}

model referentiel_critere {
  id                  String                     @id @db.Uuid
  libelle             String
  descriptif          String
  sous_criteres       referentiel_sous_critere[]
  created_at          DateTime                   @default(now())
  updated_at          DateTime                   @updatedAt
  evaluation_critere  evaluation_critere[]
  instruction_critere instruction_critere[]

  @@schema("public")
}

model referentiel_sous_critere {
  id         String              @id @db.Uuid
  libelle    String
  descriptif String
  parent_id  String              @db.Uuid
  parent     referentiel_critere @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at DateTime            @default(now())
  updated_at DateTime            @updatedAt

  @@schema("public")
}

model referentiel_rattachement {
  code                                 String                                 @id
  libelle                              String
  created_at                           DateTime                               @default(now())
  updated_at                           DateTime                               @updatedAt
  objectifs                            referentiel_objectif[]
  fiche_evaluation                     fiche_evaluation[]
  rattachement_utilisateur_etape_jalon rattachement_utilisateur_etape_jalon[]

  @@schema("public")
}

model referentiel_objectif {
  id                    String                    @id @db.Uuid
  libelle               String
  descriptif            String
  jalon                 Int
  rattachement_code     String
  rattachement          referentiel_rattachement  @relation(fields: [rattachement_code], references: [code], onDelete: Cascade, onUpdate: Cascade)
  tutelle_id            String?                   @db.Uuid
  tutelle               referentiel_tutelle?      @relation(fields: [tutelle_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt
  evaluations           evaluation_objectif[]
  instruction_objectif  instruction_objectif[]

  @@schema("public")
}

enum etape_evaluation_enum {
  AUTO_EVALUATION
  CONSOLIDATION
  INSTRUCTION

  @@schema("public")
}

model fiche_evaluation {
  id                String                   @id @db.Uuid
  jalon             Int
  etape_courante    etape_evaluation_enum
  rattachement_code String
  rattachement      referentiel_rattachement @relation(fields: [rattachement_code], references: [code], onDelete: Cascade, onUpdate: Cascade)
  created_at        DateTime                 @default(now())
  updated_at        DateTime                 @updatedAt
  etape_evaluations etape_evaluation[]

  @@unique([rattachement_code, jalon])
  @@schema("public")
}

model etape_evaluation {
  id                    String                @id @db.Uuid
  fiche_evaluation_id   String                @db.Uuid
  fiche_evaluation      fiche_evaluation      @relation(fields: [fiche_evaluation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  type                  etape_evaluation_enum
  read_only             Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  evaluations_objectifs evaluation_objectif[]
  evaluations_criteres  evaluation_critere[]

  @@unique([fiche_evaluation_id, type])
  @@schema("public")
}

model rattachement_utilisateur_etape_jalon {
  id                    String                   @id @db.Uuid
  etape                 etape_evaluation_enum
  jalon                 Int
  utilisateur_id        String                   @db.Uuid
  utilisateur           utilisateur              @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rattachement_code     String
  rattachement          referentiel_rattachement @relation(fields: [rattachement_code], references: [code], onDelete: Cascade, onUpdate: Cascade)
  created_at            DateTime                 @default(now())
  updated_at            DateTime                 @updatedAt
  instruction_objectifs instruction_objectif[]
  instruction_criteres  instruction_critere[]

  @@unique([utilisateur_id, rattachement_code, jalon, etape])
  @@schema("public")
}

model evaluation_objectif {
  id                  String               @id @db.Uuid
  etape_evaluation_id String               @db.Uuid
  etape_evaluation    etape_evaluation     @relation(fields: [etape_evaluation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  objectif_id         String               @db.Uuid
  objectif            referentiel_objectif @relation(fields: [objectif_id], references: [id])
  auteur_id           String               @db.Uuid
  auteur              utilisateur          @relation(fields: [auteur_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  note                Int?
  commentaire         String
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  @@unique([etape_evaluation_id, objectif_id, auteur_id])
  @@schema("public")
}

model evaluation_critere {
  id                  String              @id @db.Uuid
  etape_evaluation_id String              @db.Uuid
  etape_evaluation    etape_evaluation    @relation(fields: [etape_evaluation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  critere_id          String              @db.Uuid
  critere             referentiel_critere @relation(fields: [critere_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  auteur_id           String              @db.Uuid
  auteur              utilisateur         @relation(fields: [auteur_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  note                Int?
  commentaire         String
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  @@unique([etape_evaluation_id, critere_id, auteur_id])
  @@schema("public")
}

model instruction_objectif {
  id                                      String                               @id @db.Uuid
  objectif_id                             String                               @db.Uuid
  objectif                                referentiel_objectif                 @relation(fields: [objectif_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rattachement_utilisateur_etape_jalon_id String                               @db.Uuid
  rattachement_utilisateur_etape_jalon    rattachement_utilisateur_etape_jalon @relation(fields: [rattachement_utilisateur_etape_jalon_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at                              DateTime                             @default(now())
  updated_at                              DateTime                             @updatedAt

  @@unique([objectif_id, rattachement_utilisateur_etape_jalon_id])
  @@schema("public")
}

model instruction_critere {
  id                                      String                               @id @db.Uuid
  critere_id                              String                               @db.Uuid
  critere                                 referentiel_critere                  @relation(fields: [critere_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rattachement_utilisateur_etape_jalon_id String                               @db.Uuid
  rattachement_utilisateur_etape_jalon    rattachement_utilisateur_etape_jalon @relation(fields: [rattachement_utilisateur_etape_jalon_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at                              DateTime                             @default(now())
  updated_at                              DateTime                             @updatedAt

  @@unique([critere_id, rattachement_utilisateur_etape_jalon_id])
  @@schema("public")
}

model chantier_evaluation {
  id              String
  code_insee      String
  maille          Maille
  territoire_code String
  zone_id         String
  taux_avancement Float?
  date_calcul     DateTime @db.Date

  @@id([id, territoire_code, date_calcul])
  @@schema("public")
}

model indicateur_evaluation {
  id                   String
  chantier_id          String
  territoire_code      String
  code_insee           String
  maille               Maille
  zone_id              String
  taux_avancement      Float?
  ponderation_declaree Float
  ponderation_reelle   Float
  date_calcul          DateTime @db.Date

  @@id([id, territoire_code, date_calcul])
  @@schema("public")
}
