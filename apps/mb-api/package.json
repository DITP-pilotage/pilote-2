{
  "name": "@pilote/mb-api",
  "portless": "mb-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "dev": "portless run tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src && tsc --noEmit",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.12.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "portless": "^0.11.1",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.18"
  }
}
