{
  "name": "@pilote/kpilote-admin",
  "portless": "kpilote-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "portless kpilote-admin vite",
    "deploy:prepare": "bash deploy-prepare.sh",
    "routes:generate": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "build": "rm -rf dist && tsr generate && tsc --noEmit && vite build && vite build -c vite.server.config.ts",
    "deploy:bundle": "bash deploy-bundle.sh",
    "start": "node dist/server/index.js",
    "lint": "tsr generate && oxlint --type-aware src && tsc --noEmit && prettier --check .",
    "lint:fix": "tsr generate && oxlint --type-aware src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@pilote/kpilote-shared": "workspace:*",
    "@pilote/kpilote-ui": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "dotenv": "17.4.2",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "iron-session": "^9.0.1",
    "ky": "^2.2.0",
    "lucide-react": "^1.57.0",
    "neverthrow": "^8.2.0",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.44",
    "@tanstack/router-plugin": "^1.168.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "~7.0.2004",
    "pino-pretty": "^13.2.0",
    "portless": "^0.15.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
