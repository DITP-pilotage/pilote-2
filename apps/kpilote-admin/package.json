{
  "name": "@pilote/kpilote-admin",
  "portless": "kpilote-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "dev": "portless kpilote-admin vite",
    "deploy:prepare": "bash deploy-prepare.sh",
    "routes:generate": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "build": "rm -rf dist && tsr generate && tsc --noEmit && vite build && vite build -c vite.server.config.ts",
    "deploy:bundle": "bash deploy-bundle.sh",
    "start": "node dist/server/index.js",
    "lint": "tsr generate && eslint src && tsc --noEmit && prettier --check .",
    "lint:fix": "tsr generate && eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-validator": "^0.8.0",
    "@hookform/resolvers": "^5.4.0",
    "@pilote/kpilote-shared": "workspace:*",
    "@pilote/kpilote-ui": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-devtools": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dotenv": "17.4.2",
    "hono": "^4.12.27",
    "hono-rate-limiter": "^0.5.3",
    "iron-session": "^8.0.4",
    "ky": "^2.0.2",
    "lucide-react": "^1.23.0",
    "neverthrow": "^8.2.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/vite-dev-server": "^0.26.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-cli": "^1.167.18",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "pino-pretty": "^13.1.3",
    "portless": "^0.11.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3"
  }
}
