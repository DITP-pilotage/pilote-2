{
  "name": "@pilote/kpilote-admin",
  "portless": "kpilote-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "dev": "portless kpilote-admin vite",
    "deploy:prepare": "bash deploy-prepare.sh",
    "routes:generate": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "build": "rm -rf dist && tsr generate && tsc --noEmit && vite build && vite build -c vite.server.config.ts",
    "deploy:bundle": "bash deploy-bundle.sh",
    "start": "node dist/server/index.js",
    "lint": "tsr generate && eslint src && tsc --noEmit && prettier --check .",
    "lint:fix": "tsr generate && eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.8.0",
    "@hookform/resolvers": "^5.7.1",
    "@pilote/kpilote-shared": "workspace:*",
    "@pilote/kpilote-ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tiptap/core": "3.22.3",
    "@tiptap/extension-image": "3.22.3",
    "@tiptap/extension-link": "3.22.3",
    "@tiptap/extension-placeholder": "3.22.3",
    "@tiptap/extension-underline": "3.22.3",
    "@tiptap/pm": "3.22.3",
    "@tiptap/react": "3.22.3",
    "@tiptap/starter-kit": "3.22.3",
    "@tiptap/suggestion": "3.22.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "dotenv": "17.4.2",
    "hono": "^4.13.1",
    "hono-rate-limiter": "^0.5.3",
    "iron-session": "^8.0.4",
    "ky": "^2.0.2",
    "lucide-react": "^1.31.0",
    "neverthrow": "^8.2.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.27",
    "@tanstack/router-plugin": "^1.168.29",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "portless": "^0.15.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
