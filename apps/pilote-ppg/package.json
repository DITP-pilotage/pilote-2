{
  "name": "@pilote/ppg",
  "portless": "pilote.modernisation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "portless ${PORTLESS_NAME:-}pilote.modernisation next dev",
    "deploy:prepare": "bash deploy-prepare.sh",
    "build": "prisma generate && NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=${MAX_OLD_SPACE_SIZE:-768}\" next build && node copy-assets.js && prisma migrate deploy && prisma db seed",
    "build:dev": "prisma generate && next build && node copy-assets.js && prisma migrate deploy && prisma db seed",
    "deploy:bundle": "bash deploy-bundle.sh",
    "start": "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-768} .next/standalone/apps/pilote-ppg/server.js",
    "lint": "prisma generate && pnpm lint:oxlint && pnpm lint:tsc && pnpm format:check",
    "lint:fix": "pnpm lint:oxlint --fix",
    "format": "prettier --write '{src,tests}/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "format:check": "prettier --check '{src,tests}/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "lint:tsc": "pnpm exec tsc",
    "test": "vitest run",
    "test:unit": "vitest run --project client --project server-unit",
    "test:client": "vitest run --project client",
    "test:client:unit": "vitest run --project client '.unit.test.'",
    "test:client:integration": "vitest run --project client '.integration.test.'",
    "test:client:coverage": "vitest run --project client --coverage",
    "test:server": "vitest run --project server-unit --project server-integration",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:seed": "./tests/seed/seed.sh",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "test:e2e:server": "PORTLESS_PORT=1355 portless e2e-pilote dotenv -e .env.e2e -- next dev",
    "test:e2e:database:init": "dotenv -e .env.e2e -- pnpm database:init-force",
    "test:server:unit": "vitest run --project server-unit",
    "test:server:integration": "vitest run --project server-integration",
    "test:server:domain:coverage": "vitest run --project server-unit --coverage 'src/server/domain/**/*.test.*'",
    "test:server:infrastructure:coverage": "vitest run --project server-unit --coverage 'src/server/infrastructure/**/*.test.*'",
    "test:database:init": "dotenv -e .env.test -- pnpm database:init-force",
    "database:init": "prisma migrate reset && prisma generate && prisma db seed",
    "database:init-force": "prisma migrate reset --force && prisma generate && prisma db seed",
    "database:migration": "prisma migrate dev",
    "lint:oxlint": "oxlint --type-aware src tests"
  },
  "browserslist": {
    "production": [
      ">0.2% in FR",
      "last 5 years",
      "not IE <= 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
