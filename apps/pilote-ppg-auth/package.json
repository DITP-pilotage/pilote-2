{
  "name": "pilote-ppg-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "tsx acme-proxy/server.ts",
    "build": "esbuild acme-proxy/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=acme-proxy/dist/server.mjs --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:keycloak": "bash bin/kc.sh build",
    "start": "node acme-proxy/dist/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware acme-proxy && tsc --noEmit && prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "~7.0.2004",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
