{
  "name": "@pilote/kpilote-api",
  "portless": "kpilote-api.modernisation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "portless kpilote-api.modernisation vite",
    "deploy:prepare": "bash deploy-prepare.sh",
    "build": "prisma migrate deploy && prisma generate --sql && vite build",
    "db:seed": "prisma db seed",
    "deploy:bundle": "bash deploy-bundle.sh",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware src scripts && tsc --noEmit && prettier --check .",
    "lint:fix": "oxlint --type-aware src scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate --sql",
    "database:init": "prisma migrate reset --force",
    "database:migration": "prisma migrate dev",
    "api-key:generate": "tsx scripts/generate-api-key.ts",
    "feature:creer": "tsx scripts/creer-feature.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.94",
    "@hono/node-server": "2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@pilote/kpilote-acme": "workspace:*",
    "@pilote/kpilote-shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "ai": "^7.0.141",
    "chrono-node": "^2.10.3",
    "dotenv": "17.4.2",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "ky": "^2.2.0",
    "lru-cache": "^11.5.3",
    "neverthrow": "^8.2.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "~7.0.2004",
    "pino-pretty": "^13.2.0",
    "portless": "^0.15.8",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
