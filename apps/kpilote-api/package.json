{
  "name": "@pilote/kpilote-api",
  "portless": "kpilote-api.modernisation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "dev": "portless kpilote-api.modernisation vite",
    "deploy:prepare": "bash deploy-prepare.sh",
    "build": "prisma migrate deploy && prisma generate --sql && prisma db seed && vite build",
    "deploy:bundle": "bash deploy-bundle.sh",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts && tsc --noEmit && prettier --check .",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate --sql",
    "database:init": "prisma migrate reset --force",
    "database:migration": "prisma migrate dev",
    "api-key:generate": "tsx scripts/generate-api-key.ts",
    "feature:creer": "tsx scripts/creer-feature.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@pilote/kpilote-shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "17.4.2",
    "hono": "^4.12.27",
    "jose": "^6.2.3",
    "ky": "^2.0.2",
    "lru-cache": "^11.5.1",
    "neverthrow": "^8.2.0",
    "p-limit": "^7.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.0",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "eslint": "^10.6.0",
    "pino-pretty": "^13.1.3",
    "portless": "^0.15.1",
    "prettier": "^3.9.4",
    "prisma": "7.8.0",
    "tsx": "^4.22.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
