{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "paths": {
      "@/apiKey/*": ["./src/apiKey/*"],
      "@/framework/*": ["./src/framework/*"],
      "@/authentication/*": ["./src/authentication/*"],
      "@/commentaire/*": ["./src/commentaire/*"],
      "@/feature/*": ["./src/feature/*"],
      "@/healthcheck/*": ["./src/healthcheck/*"],
      "@/indicateur/*": ["./src/indicateur/*"],
      "@/individu/*": ["./src/individu/*"],
      "@/me/*": ["./src/me/*"],
      "@/referentiel/*": ["./src/referentiel/*"],
      "@/niveauConfiance/*": ["./src/niveauConfiance/*"],
      "@/valeurAvancement/*": ["./src/valeurAvancement/*"],
      "@/valeurImport/*": ["./src/valeurImport/*"],
      "@/objectifIndicateurIndividu/*": ["./src/objectifIndicateurIndividu/*"],
      "@/widget/*": ["./src/widget/*"],
      "@/dossier/*": ["./src/dossier/*"],
      "@/permission/*": ["./src/permission/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/utilisateur/*": ["./src/utilisateur/*"],
      "@/whoami/*": ["./src/whoami/*"],
      "@/generated/*": ["./src/generated/*"],
      "@/test/*": ["./src/test/*"],
      "@/config": ["./src/config"],
      "@/env": ["./src/env"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "prisma.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["dist", "node_modules"]
}
